menu "Changan UGV root mesh"
    config APP_ARCHITECTURE_VERSION
        int
        default 3
    config APP_TRANSPORT_MQTT_SERIAL
        bool
        default y
    config APP_ROOT_GATEWAY
        bool
        default y if APP_ROLE_UGV_ROOT
    choice APP_DEVICE_ROLE
        prompt "Device role"
        default APP_ROLE_UGV_ROOT
        config APP_ROLE_UGV_ROOT
            bool "UGV root: level 1, host USB tunnel"
        config APP_ROLE_UGV
            bool "UGV: level 2 relay and executor"
        config APP_ROLE_UAV
            bool "UAV: level 3 relay and executor"
        config APP_ROLE_MICRO_UAV
            bool "Micro UAV: level 4 leaf executor"
    endchoice
    config APP_TOPOLOGY_CHAIN
        bool
        default y
    config APP_NODE_ID
        string "Stable device ID"
        default "ugv-root" if APP_ROLE_UGV_ROOT
        default "ugv-001" if APP_ROLE_UGV
        default "uav-001" if APP_ROLE_UAV
        default "micro-001" if APP_ROLE_MICRO_UAV
    config APP_UGV_NODE_ID
        string "Managing root ID"
        default "ugv-root"
    config APP_MQTT_PORT
        int "Root MQTT/TLS tunnel port"
        default 8883
        range 1024 65535
    config APP_MQTT_MAX_CHANNELS
        int "Root USB tunnel channel limit"
        default 8
        range 1 8
    config APP_MQTT_SERVER_NAME
        string "TLS broker service identity"
        default "ugv-broker.lab"
    config APP_TLS_BOOTSTRAP_UNIX
        int "Trusted deployment UTC floor"
        default 0
    config APP_MESH_CHANNEL
        int "Mesh Wi-Fi channel"
        range 1 11
        default 6
    config APP_SOFTAP_PREFIX
        string "SoftAP SSID prefix"
        default "changan"
    config APP_SOFTAP_SUBNET
        int "Reserved SoftAP subnet (set per device by lab.py)"
        default 0
        range 0 254
        help
            Third octet of 192.168.N.1/24. Reserve a unique N in 4..254 in
            config/nodes.json. Zero is unassigned and rejected at startup.
    config APP_SOFTAP_PASSWORD
        string "SoftAP password"
        default "changan-lab-only"
    config APP_PARENT_POLICY_RECOVERY_AUTO
        bool "Maintenance: boot Micro with automatic parent selection"
        default n
        depends on APP_ROLE_MICRO_UAV
        help
            Recovery for an unreachable fixed parent. Temporarily ignores the
            saved binding. Once connected, apply Auto from the terminal to
            persist it. Disable this maintenance option for normal builds.
    config APP_STATUS_PERIOD_MS
        int "Telemetry interval"
        default 5000
        range 1000 10000
    config APP_IMAGE_SELFTEST_PERIOD_S
        int "Re-seed embedded self-test images every N seconds"
        default 0
        range 0 3600
        help
            Leaf builds that embed firmware/figs assets re-enqueue all of them
            every N seconds to exercise the upload path continuously. Zero
            keeps the one-shot seed on first MQTT readiness.
endmenu
