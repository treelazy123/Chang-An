CONFIG_MESH_LITE_ENABLE=y
CONFIG_MESH_LITE_NODE_INFO_REPORT=y
CONFIG_MESH_LITE_REPORT_INTERVAL=5
CONFIG_MESH_LITE_MAXIMUM_LEVEL_ALLOWED=4
CONFIG_MESH_LITE_ID=77
CONFIG_JOIN_MESH_IGNORE_ROUTER_STATUS=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_BRIDGE_SOFTAP_SSID_END_WITH_THE_MAC=y
CONFIG_FREERTOS_HZ=1000
# Mesh-Lite uses FreeRTOS timer callbacks; leave room for recovery/formatting paths.
# The upstream no_router example raises this above IDF's 2048-byte default too.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# ESP32-C6 Wi-Fi-only lab.
CONFIG_BRIDGE_ETHERNET_NETIF_ENABLE=n
CONFIG_MESH_LITE_PROV_ENABLE=n
CONFIG_ESP_MESH_LITE_OTA_ENABLE=n

# Application partition layout for the ESP32-C6 board with 2 MiB Flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y

# Listener + three end-to-root sessions, with spare sockets for mesh internals.
CONFIG_LWIP_MAX_SOCKETS=16
